# Firebase Environment Variables

# Required: Your Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Service account credentials for server-side token verification
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Firebase Configuration for Firestore
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Note: If you only provide FIREBASE_PROJECT_ID, Firebase Admin SDK can still verify tokens
# but won't be able to perform other admin operations. This is sufficient for authentication.
